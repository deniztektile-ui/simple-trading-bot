# Скопируйте этот файл в .env и вставьте свои ключи после знака =
# Файл .env не попадает в GitHub (он в .gitignore) — ключи останутся только у вас.
# Можно заполнить не все: участвуют только те ИИ, чей ключ указан.

# Claude — console.anthropic.com
ANTHROPIC_API_KEY=

# ChatGPT — platform.openai.com
OPENAI_API_KEY=

# Grok — console.x.ai
XAI_API_KEY=

# Gemini — aistudio.google.com
GEMINI_API_KEY=
